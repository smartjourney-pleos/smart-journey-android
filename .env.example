# Pleos Playground > Workspace > My Project > 프로젝트 정보에서 확인한 값을 .env에 채운다.
# .env는 커밋하지 않는다. (공개 저장소)

# 키 정보 > 프로젝트 ID(Key): 앱 심사 요청 시 Pleos App Market Console에 입력
PLEOS_PROJECT_KEY=

# SDK > 클라이언트 ID / 클라이언트 시크릿: 서버 연결이 필요한 SDK(TextToSpeech, SpeechToText) 사용 시
PLEOS_CLIENT_ID=
PLEOS_CLIENT_SECRET=

# 테스트 정보 > CRN: Pleos Connect Emulator 2.1.0 이후로는 입력이 요구되지 않는다.
PLEOS_CRN=
