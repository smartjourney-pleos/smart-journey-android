# 참고용 설정 목록입니다. 현재 Gradle·앱 런타임은 .env 파일을 읽지 않습니다.
# 현재 사용하는 Vehicle State / NaviHelper SDK는 아래 키 없이 연결합니다.
# .env가 없어도 지도·경로 API를 사용할 수 있으며, 키를 채워도 내장 내비의 지도 타일 설정은 바뀌지 않습니다.
# SDK 설치 경로와 배포 서명 설정은 README의 local.properties / SJ_RELEASE_* 항목을 참고하세요.
# 발급받은 값은 커밋하거나 APK의 BuildConfig·리소스에 넣지 마세요.

# 프로젝트 ID(Key): Pleos App Market Console에 앱 심사를 요청할 때 입력하는 값. 현재 앱은 사용하지 않습니다.
PLEOS_PROJECT_KEY=

# 서버 기반 TTS/STT의 registerApp()에서만 필요한 My Project 자격 증명.
# 현재 앱에는 해당 SDK·registerApp() 연동이 없으므로 사용하지 않습니다.
# 나중에 연동할 때 자격 증명 전달 경로를 별도로 구현해야 하며, 이 파일만 채워서는 등록되지 않습니다.
PLEOS_CLIENT_ID=
PLEOS_CLIENT_SECRET=

# Emulator 2.1.0부터 CRN 입력은 요구되지 않습니다. 현재 앱은 사용하지 않습니다.
PLEOS_CRN=
