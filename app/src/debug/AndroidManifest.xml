<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        아래 두 컴포넌트는 adb(shell)에서 부르는 시연·검증 도구라 권한을 걸지 않는다.
        signature 권한을 걸면 shell 사용자가 가질 수 없어 adb 호출이 조용히 막힌다(11/11 에뮬레이터 확인).
        debug 소스셋에만 있어 심사·배포(release) 빌드에는 들어가지 않는다.
    -->
    <application>
        <!-- 합성 PCM을 실제 Pleos ASR에 넣어 현재 질문에 답하는 검증 도구. 마이크를 녹음하지 않는다. -->
        <activity
            android:name=".debug.SpeechProbeActivity"
            android:exported="true" />

        <activity
            android:name=".debug.ProbeActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <receiver
            android:name=".debug.DemoReceiver"
            android:exported="true" />
    </application>
</manifest>
