<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 시연용: adb appops로 허용하면 백그라운드에서도 승인 카드 화면을 바로 띄울 수 있다. 심사 빌드에는 넣지 않는다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        아래 두 컴포넌트는 adb(shell)에서 부르는 시연·검증 도구라 권한을 걸지 않는다.
        signature 권한을 걸면 shell 사용자가 가질 수 없어 adb 호출이 조용히 막힌다(11/11 에뮬레이터 확인).
        debug 소스셋에만 있어 심사·배포(release) 빌드에는 들어가지 않는다.
    -->
    <application>
        <activity
            android:name=".debug.ProbeActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <receiver
            android:name=".debug.DemoReceiver"
            android:exported="true" />
    </application>
</manifest>
