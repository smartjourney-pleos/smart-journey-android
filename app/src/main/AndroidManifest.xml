<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos 차량 신호: 좌석 점유·안전벨트, 도어 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />

    <!-- NaviHelper: 정보 조회(NAVI_ROUTE), 경로 요청·변경(NAVI_ROUTE_SEARCH) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 경로 설정 후 내장 내비 화면을 전경으로 요청한다 (NaviHelper.requestNavigationScreen, normal). -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 백그라운드 엔진(JourneyService)과 상태 알림·승인 카드 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 시작 화면에서 설치된 SDK 서비스 버전을 확인한다 (Android 11+ package visibility). -->
    <queries>
        <package android:name="ai.pleos.playground.service.vehicle" />
        <package android:name="ai.pleos.playground.service.navi" />
    </queries>

    <application
        android:name=".SmartJourneyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="스마트 저니"
        android:theme="@style/Theme.SmartJourney">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 승인 카드. 별도 태스크로 떠서 닫히면 아래 화면(내비)이 그대로 남는다. 주행 중 표시 대상(DO). -->
        <activity
            android:name=".ui.ApprovalActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.smartjourney.vehicle.approval">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".service.JourneyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="내비 경로를 따라 웨이팅 시점과 도착·하차를 확인하는 여정 엔진" />
        </service>

        <receiver
            android:name=".service.PromptActionReceiver"
            android:exported="false" />

    </application>
</manifest>
